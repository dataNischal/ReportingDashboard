# Copy to `.env` (or set these directly in your shell / process manager /
# Task Scheduler env) and fill in real values. NEVER commit the filled-in
# file -- every get_engine() in this project (Codes/api/db.py,
# Codes/postgres_pipeline.py, Codes/api/create_user.py) reads exclusively
# from these variables, never from a file checked into the repo.

# --- Option A: one connection string ---
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# --- Option B: individual pieces (used only if DATABASE_URL is unset) ---
PG_HOST=<your-postgres-host>
PG_PORT=5432
PG_DATABASE=<your-database>
PG_USER=<your-user>
PG_PASSWORD=

# Optional: set only if IPAYDATA / iPayHub_Data and the tables this project
# creates (ipaydata_clean, ipayhubdata_clean, business_report,
# dashboard_credential, app_sessions, etl_watermark, forecast_cache) live
# in a non-public schema. Applied as a per-connection search_path -- no SQL
# in this repo needs to be schema-qualified when this is set.
# PG_SCHEMA=<your-schema>

# Optional session tuning (see Codes/api/security.py) -- defaults shown.
SESSION_IDLE_TIMEOUT_HOURS=12
SESSION_ABSOLUTE_MAX_DAYS=14

# Whether the session cookie requires HTTPS (see Codes/api/config.py's
# Settings.session_cookie_secure) -- defaults to true (secure) if unset.
# Leave this at true/unset for the docker-compose.yml setup, which always
# serves over HTTPS via Caddy -- only ever set to false for a plain `uvicorn
# main:app` run directly on http://localhost with no reverse proxy in front.
# SESSION_COOKIE_SECURE=true

# --- Docker (docker-compose.yml / Caddyfile) ---
# Real domain name, DNS A record pointed at this host's public IP, with
# ports 80+443 reachable from the internet: Caddy automatically obtains a
# real Let's Encrypt certificate for it. Leave unset to fall back to
# Caddy's self-signed certificate against "localhost" (fine for local
# testing; browsers will flag it as untrusted until you set a real domain).
# DOMAIN=dashboard.yourcompany.com
